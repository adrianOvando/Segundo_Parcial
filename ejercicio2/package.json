{
  "name": "ejercicio2-cicd-libros-api",
  "version": "1.1.0",
  "description": "CI/CD para la API REST de Libros con pruebas automatizadas Jest, Docker y despliegue a EC2",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "express",
    "mysql2",
    "jest",
    "supertest",
    "docker",
    "github-actions",
    "ci-cd"
  ],
  "author": "Adrian Ovando",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
